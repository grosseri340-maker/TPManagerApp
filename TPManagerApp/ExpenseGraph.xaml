<Window x:Class="TPManagerApp.ExpenseGraph"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графік витрат"
        Height="500"
        Width="800"
        Background="#EEF1F5">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Margin="0 0 0 20">

            <TextBlock Text="Період:"
                       VerticalAlignment="Center"
                       Margin="0 0 10 0"/>

            <ComboBox x:Name="PeriodBox"
                      Width="150"
                      SelectionChanged="PeriodBox_SelectionChanged">

                <ComboBoxItem Content="День"/>
                <ComboBoxItem Content="Тиждень"/>
                <ComboBoxItem Content="Місяць"/>
                <ComboBoxItem Content="Рік"/>

            </ComboBox>

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalAlignment="Center">

            <ItemsControl x:Name="ChartItems">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="10"
                                    VerticalAlignment="Bottom">

                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 5"/>

                            <Border Width="60"
                                    Height="{Binding BarHeight}"
                                    Background="Green"
                                    CornerRadius="5,5,0,0"
                                    VerticalAlignment="Bottom"/>

                            <TextBlock Text="{Binding Category}"
                                       Width="70"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0 5 0 0"/>

                        </StackPanel>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>
</Window>